# Copy to .env for local `vercel dev`, and set the same keys in the
# Vercel project's Environment Variables dashboard for deployment.
# Never commit the real .env file (it's already in .gitignore).

# Neon Postgres connection string (Project → Connection Details).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Razorpay API keys (Dashboard → Settings → API Keys).
# Use TEST mode keys until you're ready to accept real payments — test
# keys are prefixed rzp_test_, live keys rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase project (Project Settings → API). VITE_-prefixed because these
# are read client-side via import.meta.env — that's expected, the anon/
# publishable key is safe for the browser (Row Level Security is what
# actually protects the data, see supabase/schema.sql). Never put the
# service_role/secret key here or anywhere in frontend code.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Resend (https://resend.com) — get free API key, add domain, paste here
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase service_role key (Project Settings → API → service_role / secret).
# SERVER-ONLY: used by api/signup.ts to create pre-verified accounts. Set it in
# Vercel's Environment Variables. NEVER prefix it with VITE_ and never expose it
# to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Maintenance mode (middleware.ts). Set to exactly "true" to show a 503
# maintenance page to everyone on every path, including /api/*. Anything else
# (or unset) leaves the site running normally. Changing it needs a redeploy.
MAINTENANCE_MODE=false

# Secret that lets you view the real site while maintenance mode is on. Open
# https://<site>/?bypass=<this value> once; it sets a cookie (preview_access)
# and redirects to the same page. Use a long random string. Leave empty to
# give nobody a bypass.
MAINTENANCE_BYPASS_KEY=
